# API Configuration
# 
# In Development:
# - The app uses Vite's proxy to forward /api requests to http://localhost:5000
# - No CORS issues - requests go through the dev server
# - Backend must be running on http://localhost:5000
#
# In Production:
# - Set this to your actual backend API URL
VITE_API_BASE_URL=https://api.rcms.com/api

